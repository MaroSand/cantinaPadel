<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- Temporal para probar turnos hasta que el modulo de Caja este integrado.
             Cambiar a false para exigir una caja abierta real. -->
        <add key="BypassCajaTurnos" value="true" />
    </appSettings>

    <connectionStrings>
        <add name="cantinaPadel"
             connectionString="Server=localhost;Port=3306;Database=cantina_padel;Uid=root;Pwd=12345678;"
             providerName="Pomelo.EntityFrameworkCore.MySql" />
    </connectionStrings>
</configuration>
